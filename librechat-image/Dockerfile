# dirk.it favicon overlay on the stock LibreChat image.
# Decodes favicons from base64 at build time (keeps the working app; only swaps icons).
FROM ghcr.io/danny-avila/librechat:latest
USER root
RUN printf %s "" | base64 -d > "/app/client/dist/assets/favicon-16x16.png"
RUN printf %s "" | base64 -d > "/app/client/dist/assets/favicon-32x32.png"
RUN printf %s "" | base64 -d > "/app/client/dist/assets/apple-touch-icon-180x180.png"
RUN printf %s "" | base64 -d > "/app/client/dist/favicon.ico"
